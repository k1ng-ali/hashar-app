# Скопировать в android/keystore.properties и заполнить. Файл и ключ в git не кладутся.
# Ключ загрузки (upload key) создаётся один раз:
#   keytool -genkeypair -v -keystore hashar-upload.jks -alias hashar -keyalg RSA -keysize 2048 -validity 10000
# Путь — относительно папки android/ (или абсолютный). Потерянный ключ можно сбросить
# через поддержку Google Play, но лучше хранить его копию в надёжном месте.
storeFile=hashar-upload.jks
storePassword=
keyAlias=hashar
keyPassword=
