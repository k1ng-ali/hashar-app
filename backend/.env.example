# Подпись JWT — в проде обязательно длинная случайная строка
SECRET_KEY=change-me-to-long-random-string
ALGORITHM=HS256

# Локально cookie ходят по http, в проде — только https
COOKIE_SECURE=false
# lax — фронт и API на одном сайте (hashar.app + api.hashar.app); none — API на чужом домене (нужен COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Откуда фронтенду можно ходить к API с cookie, через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Вход через Google: Client ID OAuth-клиентов (веб и Android) через запятую. Пусто — вход выключен
GOOGLE_CLIENT_IDS=

# Коды подтверждения по SMS (Payomchi, только номера +992): API-ключ со страницы «API Ключи» на payomchi.tj
# и одобренный там Sender ID (пусто — отправитель по умолчанию). Без ключа подтверждение по SMS выключено,
# в DEV_MODE коды пишутся в лог бэкенда
PAYOMCHI_API_KEY=
PAYOMCHI_SENDER_ID=
# Уведомления админу платформы в Telegram о новых заявках на тариф: токен бота от @BotFather и id чата
# (см. README → «Уведомления в Telegram»). Пусто — уведомления выключены
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# /docs, /auth/dev-login, быстрый вход демо-пользователями, демо-чеки и seed. В проде — false
DEV_MODE=true

DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=fund_system

# Хранилище чеков по S3 API. Локально — RustFS из docker-compose (`docker compose up -d storage`,
# затем `python -m scripts.init_storage` создаёт бакет), в проде — Cloudflare R2 (см. deploy/.env.example).
# Пусто — загрузка чеков выключена, работают только демо-чеки
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=hashar-receipts
