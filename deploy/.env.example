# ─── Продакшен: скопировать в deploy/.env и заполнить ─────────────────────────

# Домен приложения (GitHub Pages) — откуда браузеру можно ходить к API (CORS)
DOMAIN=hashar.app
# Поддомен API: A-запись в Cloudflare на этот сервер, проксирование включено
API_DOMAIN=api.hashar.app
# Порт Caddy на сервере. 443 — если порт свободен. Если 443 занят другим проектом
# (например, его nginx) — 8443 и в Cloudflare Origin Rule: api.hashar.app → Destination Port 8443
API_PORT=443

# Образ backend из Docker Hub: <DOCKERHUB_USERNAME>/hashar-backend (без тега).
# Если репозиторий в Docker Hub приватный — один раз `docker login` на сервере
BACKEND_IMAGE=
# Тег образа: latest — последняя сборка из release; sha-<коммит> — закрепить версию
BACKEND_TAG=latest

# Подпись JWT: длинная случайная строка, например `openssl rand -hex 32`. Не менять без нужды —
# смена разлогинит всех пользователей
SECRET_KEY=

ALGORITHM=HS256

DB_USER=hashar
# Длинный случайный пароль: `openssl rand -hex 24`
DB_PASSWORD=
DB_NAME=hashar

# Вход через Google: Client ID веб-клиента OAuth из Google Cloud Console (тот же, что VITE_GOOGLE_CLIENT_ID
# у фронтенда). Несколько — через запятую. Пусто — вход через Google выключен
GOOGLE_CLIENT_IDS=

# Коды подтверждения по SMS (Payomchi, только номера +992): API-ключ со страницы «API Ключи» на payomchi.tj
# и одобренный там Sender ID (пусто — отправитель по умолчанию). Без ключа подтверждение по SMS выключено,
# в DEV_MODE коды пишутся в лог бэкенда
PAYOMCHI_API_KEY=
PAYOMCHI_SENDER_ID=

# Хранилище чеков — Cloudflare R2 по S3 API. Бакет приватный (без публичного домена и r2.dev).
# Endpoint: R2 → Overview → «S3 API», вида https://<account_id>.r2.cloudflarestorage.com (без имени бакета).
# Ключи: R2 → Manage API tokens → Object Read & Write только на этот бакет.
# В бакете — правило жизненного цикла: удалять объекты с префиксом tmp/ через 1 день (незавершённые загрузки)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
