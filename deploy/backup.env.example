# ─── Бэкапы БД в Cloudflare R2: скопировать в deploy/backup.env, chmod 600 ────
# Отдельный файл, а не .env: .env целиком попадает в контейнер backend, а ключ к бэкапам
# приложению не нужен. Пусто — бэкапы остаются только на сервере (backups/).

# Отдельный бакет (не бакет чеков) с правилами жизненного цикла и блокировки на префикс db/ —
# см. README → «Бэкапы». Endpoint тот же, что у чеков: https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT_URL=
# Отдельный токен: R2 → Manage API tokens → Object Read & Write только на бакет бэкапов
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=hashar-backups

# Необязательно: адрес пинга мониторинга (например, https://hc-ping.com/<uuid> на healthchecks.io,
# расписание «раз в сутки»). Успех — пинг, ошибка — <адрес>/fail, тишина — бэкап не запускался.
# Мониторинг пришлёт письмо или сообщение в Telegram
BACKUP_PING_URL=
